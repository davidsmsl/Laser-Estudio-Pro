{
  "name": "laser-estudio-pro",
  "version": "1.2.2",
  "description": "Diseño y control de láser en español",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win",
    "tienda": "node scripts/construir-tienda.js",
    "firmado": "node scripts/construir-firmado.js"
  },
  "keywords": [],
  "author": "DjSuarez",
  "license": "ISC",
  "dependencies": {
    "clipper-lib": "^6.4.2",
    "dxf-parser": "^1.1.2",
    "esptool-js": "^0.5.4",
    "imagetracerjs": "^1.2.6",
    "opentype.js": "^2.0.0",
    "three": "^0.187.0"
  },
  "devDependencies": {
    "electron": "^33.4.11",
    "electron-builder": "^26.18.0"
  },
  "productName": "Láser Estudio Pro",
  "build": {
    "appId": "co.djsuarez.laserestudio",
    "productName": "Laser Estudio Pro",
    "files": [
      "main.js",
      "preload.js",
      "src/**/*",
      "build/icon.png",
      "package.json"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.png",
      "signAndEditExecutable": true
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "language": "3082",
      "installerLanguages": [
        "es_ES"
      ],
      "shortcutName": "Laser Estudio Pro",
      "artifactName": "LaserEstudioPro-Instalador-${version}.${ext}"
    },
    "portable": {
      "artifactName": "LaserEstudioPro-Portable-${version}.${ext}"
    },
    "fileAssociations": [
      {
        "ext": "lep",
        "name": "Proyecto Laser Estudio",
        "description": "Proyecto de Láser Estudio Pro"
      }
    ]
  }
}
